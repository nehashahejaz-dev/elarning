@model IEnumerable<mypro.Models.Course>

<div class="container py-5 min-vh-100">
    <div class="d-flex justify-content-between align-items-end mb-5">
        <div>
            <h2 class="unbounded display-5 fw-bold text-white">My Learning</h2>
            <p class="text-white-50 mb-0">Aapne in courses mein enroll kiya hua hai.</p>
        </div>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var course in Model)
            {
                <div class="col-lg-4 col-md-6">
                    @* Card white background ke sath *@
                    <div class="course-card-modern shadow-sm h-100 overflow-hidden rounded-4 animate__animated animate__fadeInUp">
                        <img src="@(string.IsNullOrEmpty(course.ThumbnailUrl) ? "/images/placeholder.jpg" : course.ThumbnailUrl)"
                             class="card-img-top" style="height: 200px; object-fit: cover;">

                        <div class="card-body p-4">
                            @* Title ab dark text mein hai *@
                            <h5 class="fw-bold text-dark mb-3">@course.Title</h5>

                          

                            <div class="progress mb-4" style="height: 6px; background: #e9ecef;">
                                <div class="progress-bar bg-primary" style="width: 40%"></div>
                            </div>

                            @* Yahan sirf wahi classes hain jo aapki style.css mein button ke liye ho sakti hain *@
                            <a href="@Url.Action("Watch", "home", new { id = course.CourseId })"
                               class=" category-icon w-100 text-center text-decoration-none d-block">
                                Continue Watching
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <div class="mb-4">
                    <i class="bi bi-book text-white-50" style="font-size: 4rem;"></i>
                </div>
                <p class="text-white-50 fs-5">You haven't enrolled in any courses yet.</p>
                <a href="@Url.Action("course", "Home")" class="btn-enroll-custom px-5 text-decoration-none">
                    Explore Courses
                </a>
            </div>
        }
    </div>
</div>